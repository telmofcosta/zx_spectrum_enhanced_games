808514	8000 8000 67A0 7FE0 67A0 8000 8000 8000	; pile row 4: ..aba...  (a=70 EFCE00, b=71 FFFF00)
808515	8000 67A0 7FE0 67A0 7FE0 67A0 8000 8000	; pile row 5: .ababa..  (a=70 EFCE00, b=71 FFFF00)
808516	67A0 7FE0 7FE0 67A0 67A0 67A0 67A0 8000	; pile row 6: abbaaaa.  (a=70 EFCE00, b=71 FFFF00)
